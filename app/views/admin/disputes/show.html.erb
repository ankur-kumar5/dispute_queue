<h3>Add Evidence</h3>

<%= form_with url: admin_dispute_evidences_path(@dispute), method: :post do %>
  <div>
    <label>Kind</label>
    <%= text_field_tag :kind %>
  </div>

  <div>
    <label>Note</label>
    <%= text_area_tag :note %>
  </div>

  <div>
    <label>File Path (optional)</label>
    <%= text_field_tag :file_path %>
  </div>

  <%= submit_tag "Attach Evidence" %>
<% end %>
